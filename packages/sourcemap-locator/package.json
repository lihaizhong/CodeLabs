{
  "name": "sourcemap-locator",
  "version": "1.0.0",
  "type": "module",
  "description": "A powerful sourcemap locator tool that supports multi-layer recursive parsing to find the original source code location",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "unpkg": "lib/index.min.js",
  "types": "index.d.ts",
  "exports": {
    "import": "./esm/index.js",
    "default": "./lib/index.js",
    "unpkg": "./lib/index.min.js",
    "types": "./index.d.ts"
  },
  "bin": {
    "sourcemap-locator": "bin/index.js",
    "sml": "bin/index.js"
  },
  "files": [
    "lib",
    "esm",
    "bin",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "declare": "tsc",
    "cleanup": "rimraf -rf esm lib types index.d.ts",
    "generate": "rollup -c",
    "build": "npm run cleanup && npm run declare && npm run generate",
    "dev": "rollup -c --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "sourcemap",
    "source-map",
    "locator",
    "debug",
    "typescript",
    "javascript",
    "cli",
    "recursive",
    "mapping"
  ],
  "author": "CodeLabs Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "source-map": "^0.7.6",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codelabs/sourcemap-locator.git"
  },
  "bugs": {
    "url": "https://github.com/codelabs/sourcemap-locator/issues"
  },
  "homepage": "https://github.com/codelabs/sourcemap-locator#readme"
}