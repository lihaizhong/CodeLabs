{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationDir": "types",
    "outDir": "types",
    "stripInternal": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "globals.d.ts"
  ],
  "exclude": [
    "__mocks__/**",
    "__tests__/**"
  ]
}